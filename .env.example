# Copy to .env and fill in. Never commit .env.

# Optional: Claude scores every lead against your ideal-customer profile.
# Without it, the pipeline falls back to the transparent rule-based score.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: hot leads are posted to this Slack incoming webhook.
SLACK_WEBHOOK_URL=

# Sent with every request so site owners and OpenStreetMap know who is crawling.
CONTACT_EMAIL=you@example.com
